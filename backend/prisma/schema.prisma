// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// CORE ACCOUNT TYPES
// ============================================

enum AccountType {
  SUPER_ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

// Users table - This is synced with Supabase Auth
model User {
  id                String        @id @default(uuid())
  email             String        @unique
  accountType       AccountType    @default(USER)
  status            UserStatus    @default(PENDING)
  lastLogin         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations
  memberships       SchoolMembership[]
  profile           UserProfile?
  teachers          Teacher[]     @relation("TeacherUser")
  parents           Parent[]      @relation("ParentUser")
  staff             Staff[]       @relation("StaffUser")

  @@map("users")
}

// User profile with additional information
model UserProfile {
  id                String        @id @default(uuid())
  userId            String        @unique
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  firstName         String?
  lastName          String?
  phoneNumber       String?
  avatar            String?
  dateOfBirth       DateTime?
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@map("user_profiles")
}

// ============================================
// SCHOOL MANAGEMENT
// ============================================

enum SchoolStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model School {
  id                String        @id @default(uuid())
  schoolCode        String        @unique // Human-readable school code (e.g., TLS001)
  name              String
  address           String?
  phoneNumber       String?
  email             String?
  logo              String?
  
  status            SchoolStatus  @default(PENDING)
  
  // Academic configuration
  academicYear      String?       // e.g., "2025/2026"
  currentTerm       String?       // e.g., "Term 1"
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations
  memberships       SchoolMembership[]
  students          Student[]
  teachers          Teacher[]
  parents           Parent[]
  staff             Staff[]
  classes           Class[]
  departments       Department[]
  subjects          Subject[]
  academicYears     AcademicYear[]
  terms             Term[]
  feeStructures     FeeStructure[]
  payments          Payment[]
  expenses          Expense[]
  assignments       Assignment[]
  announcements     Announcement[]
  notifications     Notification[]
  calendarEvents    CalendarEvent[]
  documents         Document[]
  settings          SchoolSetting[]
  timetables        Timetable[]
  disciplineRecords DisciplineRecord[]
  healthRecords     HealthRecord[]
  libraryBooks      LibraryBook[]
  bookLoans         BookLoan[]
  inventoryAssets   InventoryAsset[]
  transportRoutes   TransportRoute[]
  staffLeaves       StaffLeave[]
  admissions        AdmissionApplication[]
  rooms             Room[]
  houses            House[]
  gradingSystems    GradingSystem[]
  assessments       Assessment[]
  reportCards       ReportCard[]
  feeCategories     FeeCategory[]
  studentBills      StudentBill[]
  paymentReversals  PaymentReversal[]
  accountHeads      AccountHead[]
  incomeTransactions IncomeTransaction[]
  bankAccounts      BankAccount[]
  exeats            ExeatRequest[]
  dormitories       Dormitory[]
  visitorLogs       VisitorLog[]
  lessonPlans       LessonPlan[]
  salaryStructures  SalaryStructure[]
  payrollPeriods    PayrollPeriod[]
  payrollRuns       PayrollRun[]
  payslips          Payslip[]
  smsLogs           SmsLog[]
  smsTemplates      SmsTemplate[]
  messages          Message[]
  idCardTemplates   IdCardTemplate[]

  @@index([schoolCode])
  @@index([status])
  @@map("schools")
}

// School membership - links users to schools
enum MembershipStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

model SchoolMembership {
  id                String              @id @default(uuid())
  userId            String
  schoolId          String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  school            School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  
  profile           String              // SCHOOL_ADMIN, TEACHER, STUDENT, PARENT, etc.
  status            MembershipStatus    @default(PENDING)
  permissions       Json?               // Additional permissions if needed
  
  joinedAt          DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([userId, schoolId])
  @@index([userId])
  @@index([schoolId])
  @@index([status])
  @@map("school_memberships")
}

// ============================================
// ACADEMIC STRUCTURE
// ============================================

model AcademicYear {
  id                String        @id @default(uuid())
  schoolId          String
  school            School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  
  name              String        // e.g., "2025/2026"
  startDate         DateTime
  endDate           DateTime
  isActive          Boolean       @default(false)
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations
  terms             Term[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("academic_years")
}

model Term {
  id                String        @id @default(uuid())
  schoolId          String
  academicYearId    String?
  school            School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear      AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  
  name              String        // e.g., "Term 1", "Semester 1"
  startDate         DateTime
  endDate           DateTime
  isActive          Boolean       @default(false)
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([schoolId, name, academicYearId])
  @@index([schoolId])
  @@index([academicYearId])
  @@map("terms")
}

model Department {
  id                String        @id @default(uuid())
  schoolId          String
  school            School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  
  name              String
  description       String?
  headOfDepartment  String?
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations
  classes           Class[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("departments")
}

model Class {
  id                String        @id @default(uuid())
  schoolId          String
  school            School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  departmentId      String?
  department        Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  
  name              String        // e.g., "Class 5", "JHS 1"
  stream            String?       // e.g., "A", "B"
  level             String?       // e.g., "Primary", "JHS"
  classTeacherId    String?
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations
  students          Student[]
  assignments       Assignment[]
  timetables        Timetable[]

  @@unique([schoolId, name, stream])
  @@index([schoolId])
  @@index([departmentId])
  @@map("classes")
}

// ============================================
// TIMETABLE / SCHEDULING
// ============================================

model Timetable {
  id                String        @id @default(uuid())
  schoolId          String
  school            School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId           String
  class             Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId         String?
  subject           Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  teacherId         String?
  teacher           Teacher?      @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  dayOfWeek         Int           // 1=Monday … 5=Friday
  periodNumber      Int           // 1–8
  startTime         String        // e.g. "07:30"
  endTime           String        // e.g. "08:10"
  roomNumber        String?

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([schoolId, classId, dayOfWeek, periodNumber])
  @@index([schoolId])
  @@index([classId])
  @@index([teacherId])
  @@map("timetables")
}

model Subject {
  id                String        @id @default(uuid())
  schoolId          String
  school            School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  
  name              String
  code              String?
  description       String?
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations
  timetables        Timetable[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("subjects")
}

// ============================================
// STUDENTS
// ============================================

model Student {
  id                String        @id @default(uuid())
  schoolId          String
  school            School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId           String?
  class             Class?        @relation(fields: [classId], references: [id], onDelete: SetNull)
  
  admissionNumber   String        @unique // School-specific student ID
  firstName         String
  lastName          String
  dateOfBirth       DateTime?
  gender            String?
  address           String?
  phoneNumber       String?
  email             String?
  photo             String?
  
  admissionDate     DateTime      @default(now())
  status            String        @default("ACTIVE") // ACTIVE, GRADUATED, WITHDRAWN, TRANSFERRED
  nationality       String?       @default("Ghanaian")
  house             String?
  boardingStatus    String        @default("DAY") // DAY, BOARDING
  emergencyContact  String?
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations
  guardians         StudentGuardian[]
  attendance        Attendance[]
  results           Result[]
  fees              StudentFee[]
  assignments       AssignmentSubmission[]
  disciplineRecords DisciplineRecord[]
  healthRecords     HealthRecord[]
  bookLoans         BookLoan[]
  reportCards       ReportCard[]
  studentBills      StudentBill[]
  exeats            ExeatRequest[]
  bedAllocations    BedAllocation[]

  @@unique([schoolId, admissionNumber])
  @@index([schoolId])
  @@index([classId])
  @@index([admissionNumber])
  @@map("students")
}

model StudentGuardian {
  id                String        @id @default(uuid())
  studentId         String
  student           Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parentId          String
  parent            Parent        @relation(fields: [parentId], references: [id], onDelete: Cascade)
  
  relationship      String        // FATHER, MOTHER, GUARDIAN
  isPrimary         Boolean       @default(false)
  emergencyContact  Boolean       @default(false)
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([studentId, parentId])
  @@index([studentId])
  @@index([parentId])
  @@map("student_guardians")
}

// ============================================
// TEACHERS
// ============================================

model Teacher {
  id                String        @id @default(uuid())
  schoolId          String
  school            School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId            String?       @unique // If teacher has a user account
  user              User?         @relation("TeacherUser", fields: [userId], references: [id], onDelete: SetNull)
  
  employeeId        String        @unique
  firstName         String
  lastName          String
  email             String?
  phoneNumber       String?
  qualifications    String?
  subjects          String[]      // Array of subject IDs
  classes           String[]      // Array of class IDs
  departmentId      String?
  
  employmentDate   DateTime      @default(now())
  status            String        @default("ACTIVE")
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations
  timetables        Timetable[]
  lessonPlans       LessonPlan[]

  @@unique([schoolId, employeeId])
  @@index([schoolId])
  @@index([userId])
  @@map("teachers")
}

// ============================================
// PARENTS
// ============================================

model Parent {
  id                String        @id @default(uuid())
  schoolId          String
  school            School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId            String?       @unique // If parent has a user account
  user              User?         @relation("ParentUser", fields: [userId], references: [id], onDelete: SetNull)
  
  firstName         String
  lastName          String
  email             String?
  phoneNumber       String?
  address           String?
  occupation        String?
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations
  children          StudentGuardian[]

  @@index([schoolId])
  @@index([userId])
  @@map("parents")
}

// ============================================
// STAFF
// ============================================

model Staff {
  id                String        @id @default(uuid())
  schoolId          String
  school            School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId            String?       @unique
  user              User?         @relation("StaffUser", fields: [userId], references: [id], onDelete: SetNull)
  
  employeeId        String        @unique
  firstName         String
  lastName          String
  email             String?
  phoneNumber       String?
  role              String        // ACCOUNTANT, RECEPTIONIST, LIBRARIAN, etc.
  department        String?
  
  employmentDate   DateTime      @default(now())
  status            String        @default("ACTIVE")
  leaves            StaffLeave[]
  salaryStructure   SalaryStructure?
  payrollItems      PayrollItem[]
  payslips          Payslip[]
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([schoolId, employeeId])
  @@index([schoolId])
  @@index([userId])
  @@map("staff")
}

// ============================================
// ATTENDANCE
// ============================================

model Attendance {
  id                String        @id @default(uuid())
  schoolId          String
  studentId         String
  student           Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId           String?
  
  date              DateTime
  status            String        // PRESENT, ABSENT, LATE, EXCUSED
  remarks           String?
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([studentId, date])
  @@index([schoolId])
  @@index([studentId])
  @@index([date])
  @@map("attendance")
}

// ============================================
// ACADEMICS - RESULTS
// ============================================

model Result {
  id                String        @id @default(uuid())
  schoolId          String
  studentId         String
  student           Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId         String?
  classId           String?
  termId            String?
  academicYearId    String?
  
  assessmentType    String        // CLASSWORK, ASSIGNMENT, TEST, EXAM
  score             Float
  maxScore          Float
  grade             String?
  remarks           String?
  
  isPublished       Boolean       @default(false)
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([schoolId])
  @@index([studentId])
  @@index([subjectId])
  @@index([termId])
  @@map("results")
}

// ============================================
// FINANCE
// ============================================

model FeeStructure {
  id                String        @id @default(uuid())
  schoolId          String
  school            School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId           String?
  
  name              String
  description       String?
  amount            Float
  currency          String        @default("GHS")
  academicYear      String?
  term              String?
  
  isActive          Boolean       @default(true)
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([schoolId])
  @@index([classId])
  @@map("fee_structures")
}

model StudentFee {
  id                String        @id @default(uuid())
  schoolId          String
  studentId         String
  student           Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructureId    String?
  
  name              String
  amount            Float
  paidAmount        Float         @default(0)
  discountAmount    Float         @default(0)
  scholarshipName   String?
  balance           Float
  academicYear      String?
  term              String?
  status            String        @default("PENDING") // PENDING, PARTIAL, PAID, OVERDUE
  
  dueDate           DateTime?
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([schoolId])
  @@index([studentId])
  @@map("student_fees")
}

model Payment {
  id                String        @id @default(uuid())
  schoolId          String
  school            School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId         String?
  studentFeeId      String?
  
  amount            Float
  paymentMethod     String        // CASH, BANK, MOBILE_MONEY
  reference         String?       // Transaction reference
  receiptNumber     String        @unique
  description       String?
  
  paidBy            String?
  receivedBy        String?
  
  isReversed        Boolean       @default(false)
  reversalReason    String?
  reversedAt        DateTime?
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  allocations       PaymentAllocation[]
  reversal          PaymentReversal?

  @@index([schoolId])
  @@index([studentId])
  @@index([receiptNumber])
  @@map("payments")
}

model Expense {
  id                String        @id @default(uuid())
  schoolId          String
  school            School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  
  category          String
  description       String
  amount            Float
  currency          String        @default("GHS")
  expenseDate       DateTime
  
  approvedBy        String?
  receipt           String?
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([schoolId])
  @@index([expenseDate])
  @@map("expenses")
}

// ============================================
// ASSIGNMENTS
// ============================================

model Assignment {
  id                String        @id @default(uuid())
  schoolId          String
  school            School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherId         String?
  classId           String?
  class             Class?        @relation(fields: [classId], references: [id], onDelete: SetNull)
  subjectId         String?

  title             String
  description       String?
  dueDate           DateTime?
  totalMarks        Float?
  attachments       String[]      // Array of file URLs

  isPublished       Boolean       @default(false)

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations
  submissions       AssignmentSubmission[]

  @@index([schoolId])
  @@index([classId])
  @@index([teacherId])
  @@map("assignments")
}

model AssignmentSubmission {
  id                String        @id @default(uuid())
  assignmentId      String
  assignment        Assignment    @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId         String
  student           Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  content           String?
  attachments       String[]      // Array of file URLs
  score             Float?
  feedback          String?
  submittedAt       DateTime      @default(now())
  gradedAt          DateTime?
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
  @@map("assignment_submissions")
}

// ============================================
// NOTIFICATIONS & ANNOUNCEMENTS
// ============================================

model Announcement {
  id                String        @id @default(uuid())
  schoolId          String
  school            School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  
  title             String
  content           String
  targetType        String        // SCHOOL, CLASS, DEPARTMENT, SPECIFIC
  targetIds         String[]      // Array of target IDs
  priority          String        @default("NORMAL") // NORMAL, URGENT, IMPORTANT
  
  publishedBy       String?
  isPublished       Boolean       @default(false)
  publishedAt       DateTime?
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([schoolId])
  @@index([isPublished])
  @@map("announcements")
}

model Notification {
  id                String        @id @default(uuid())
  schoolId          String
  school            School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  recipientUserId   String?
  
  type              String
  title             String
  message           String
  relatedEntityType String?
  relatedEntityId   String?
  
  isRead            Boolean       @default(false)
  readAt            DateTime?
  
  createdAt         DateTime      @default(now())

  @@index([schoolId])
  @@index([recipientUserId])
  @@index([isRead])
  @@map("notifications")
}

// ============================================
// CALENDAR
// ============================================

model CalendarEvent {
  id                String        @id @default(uuid())
  schoolId          String
  school            School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  
  title             String
  description       String?
  startDate         DateTime
  endDate           DateTime?
  eventType         String        // EXAM, HOLIDAY, MEETING, EVENT
  location          String?
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([schoolId])
  @@index([startDate])
  @@map("calendar_events")
}

// ============================================
// DOCUMENTS
// ============================================

model Document {
  id                String        @id @default(uuid())
  schoolId          String
  school            School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  
  title             String
  description       String?
  fileType          String        // CERTIFICATE, REPORT_CARD, LETTER, etc.
  filePath          String        // Storage path
  fileSize          Int?
  mimeType          String?
  
  uploadedBy        String?
  relatedEntityType String?
  relatedEntityId   String?
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([schoolId])
  @@index([fileType])
  @@map("documents")
}

// ============================================
// SCHOOL SETTINGS
// ============================================

model SchoolSetting {
  id                String        @id @default(uuid())
  schoolId          String
  school            School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  
  key               String
  value             String
  description       String?
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([schoolId, key])
  @@index([schoolId])
  @@map("school_settings")
}

// ============================================
// AUDIT LOGS
// ============================================

model AuditLog {
  id                String        @id @default(uuid())
  
  userId            String?
  action            String        // CREATE_SCHOOL, SUSPEND_SCHOOL, etc.
  entityType        String?       // SCHOOL, USER, STUDENT, etc.
  entityId          String?
  schoolId          String?
  
  details           Json?
  ipAddress         String?
  userAgent         String?
  
  result            String        // SUCCESS, FAILURE
  createdAt         DateTime      @default(now())

  @@index([userId])
  @@index([schoolId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// PHASE 5: OPERATIONS
// ============================================

model DisciplineRecord {
  id                String        @id @default(uuid())
  schoolId          String
  school            School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId         String
  student           Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  incidentDate      DateTime      @default(now())
  title             String
  infractionType    String        // BULLYING, TRUANCY, MISCONDUCT, LATENESS, DISOBEDIENCE
  description       String
  sanction          String        // VERBAL_WARNING, WRITTEN_WARNING, DETENTION, SUSPENSION, EXPULSION
  status            String        @default("ACTIVE") // ACTIVE, RESOLVED, APPEALED
  reportedBy        String?
  actionTaken       String?
  parentNotified    Boolean       @default(false)
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([schoolId])
  @@index([studentId])
  @@map("discipline_records")
}

model HealthRecord {
  id                String        @id @default(uuid())
  schoolId          String
  school            School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId         String
  student           Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  visitDate         DateTime      @default(now())
  symptoms          String
  diagnosis         String?
  treatment         String?
  medicationGiven   String?
  temperature       String?
  attendedBy        String?
  parentContacted   Boolean       @default(false)
  referredToHospital Boolean      @default(false)
  remarks           String?
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([schoolId])
  @@index([studentId])
  @@map("health_records")
}

model LibraryBook {
  id                String        @id @default(uuid())
  schoolId          String
  school            School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  
  title             String
  author            String
  isbn              String?
  category          String        // FICTION, SCIENCE, MATHEMATICS, HISTORY, REFERENCE
  publisher         String?
  yearPublished     Int?
  totalCopies       Int           @default(1)
  availableCopies   Int           @default(1)
  shelfLocation     String?
  
  loans             BookLoan[]

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([schoolId])
  @@map("library_books")
}

model BookLoan {
  id                String        @id @default(uuid())
  schoolId          String
  school            School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  bookId            String
  book              LibraryBook   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  studentId         String
  student           Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  borrowDate        DateTime      @default(now())
  dueDate           DateTime
  returnDate        DateTime?
  status            String        @default("BORROWED") // BORROWED, RETURNED, OVERDUE, LOST
  fineAmount        Float         @default(0)
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([schoolId])
  @@index([bookId])
  @@index([studentId])
  @@map("book_loans")
}

model InventoryAsset {
  id                String        @id @default(uuid())
  schoolId          String
  school            School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  
  name              String
  category          String        // IT_EQUIPMENT, FURNITURE, LAB_APPARATUS, SPORTS, VEHICLE
  serialNumber      String?
  location          String        // Science Lab 1, ICT Room, etc.
  condition         String        @default("GOOD") // NEW, GOOD, FAIR, POOR, DAMAGED
  quantity          Int           @default(1)
  purchasePrice     Float?
  purchaseDate      DateTime?
  lastMaintenance   DateTime?
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([schoolId])
  @@map("inventory_assets")
}

model TransportRoute {
  id                String        @id @default(uuid())
  schoolId          String
  school            School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  
  name              String        // Route 1 - East Legon / Madina
  vehicleNumber     String        // GR-4029-22
  driverName        String
  driverPhone       String
  capacity          Int           @default(30)
  pickupPoints      String        // Comma separated stops
  feePerTerm        Float         @default(0)
  status            String        @default("ACTIVE")
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([schoolId])
  @@map("transport_routes")
}

model StaffLeave {
  id                String        @id @default(uuid())
  schoolId          String
  school            School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staffId           String
  staff             Staff         @relation(fields: [staffId], references: [id], onDelete: Cascade)
  
  leaveType         String        // CASUAL, SICK, ANNUAL, MATERNITY, STUDY
  startDate         DateTime
  endDate           DateTime
  daysCount         Int
  reason            String
  status            String        @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy        String?
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([schoolId])
  @@index([staffId])
  @@map("staff_leaves")
}

// ============================================
// PHASE 1 UPGRADES: ADMISSIONS
// ============================================

model AdmissionApplication {
  id                    String              @id @default(uuid())
  schoolId              String
  school                School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  applicationNumber     String              // Unique per school e.g. APP-2026-001
  firstName             String
  lastName              String
  dateOfBirth           DateTime?
  gender                String?
  nationality           String?             @default("Ghanaian")
  previousSchool        String?
  applyingForClass      String?
  guardianName          String
  guardianPhone         String
  guardianEmail         String?
  guardianAddress       String?
  guardianRelationship  String?             // FATHER, MOTHER, GUARDIAN
  medicalConditions     String?

  applicationFee        Float               @default(0)
  feePaid               Boolean             @default(false)
  status                String              @default("DRAFT") // DRAFT, SUBMITTED, UNDER_REVIEW, SHORTLISTED, ACCEPTED, REJECTED, WAITLISTED, WITHDRAWN
  
  offerDate             DateTime?
  acceptanceDeadline    DateTime?
  convertedToStudentId  String?             // Linked Student ID once converted

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  documents             AdmissionDocument[]

  @@unique([schoolId, applicationNumber])
  @@index([schoolId])
  @@index([status])
  @@map("admission_applications")
}

model AdmissionDocument {
  id            String               @id @default(uuid())
  applicationId String
  application   AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  documentType  String               // BIRTH_CERT, REPORT_CARD, PASSPORT_PHOTO, MEDICAL
  fileName      String
  fileUrl       String
  uploadedAt    DateTime             @default(now())

  @@index([applicationId])
  @@map("admission_documents")
}

// ============================================
// PHASE 2 UPGRADES: ROOMS & HOUSES
// ============================================

model Room {
  id          String    @id @default(uuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String    // e.g. "Science Lab 1", "Room 102"
  capacity    Int       @default(40)
  roomType    String    @default("CLASSROOM") // CLASSROOM, LAB, LIBRARY, HALL, SICKBAY
  building    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("rooms")
}

model House {
  id          String    @id @default(uuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String    // e.g. "Aggrey", "Nkrumah", "Guggisberg"
  color       String?
  masterName  String?
  motto       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("houses")
}

// ============================================
// PHASE 4 UPGRADES: GHANA GRADING, ASSESSMENTS & REPORT CARDS
// ============================================

model GradingSystem {
  id          String         @id @default(uuid())
  schoolId    String
  school      School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String         // e.g. "Ghana Primary (1-6)", "BECE Stanine (1-9)", "Standard Letter (A-F)"
  code        String         // GH_PRIMARY, BECE_STANINE, LETTER_GRADE
  description String?
  isDefault   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  scales      GradingScale[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@map("grading_systems")
}

model GradingScale {
  id              String        @id @default(uuid())
  gradingSystemId String
  gradingSystem   GradingSystem @relation(fields: [gradingSystemId], references: [id], onDelete: Cascade)
  grade           String        // 1, 2, 3... or A+, A, B...
  minScore        Float
  maxScore        Float
  gradePoint      Float         @default(0)
  descriptor      String        // HIGHEST, HIGHER, HIGH, HIGH_AVERAGE, AVERAGE, LOW_AVERAGE, LOWER, LOWEST, FAIL
  remarks         String        // Excellent, Very Good, Good, Credit, Pass, Fail

  @@index([gradingSystemId])
  @@map("grading_scales")
}

model Assessment {
  id                String    @id @default(uuid())
  schoolId          String
  school            School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId           String
  subjectId         String
  academicYear      String
  term              String
  name              String    // Mid-Term CA 1, End-of-Term Exam
  type              String    // CLASSWORK, ASSIGNMENT, QUIZ, TEST, SBA, EXAM
  weightPercentage  Float     @default(30) // e.g. CA=30%, Exam=70%
  maxMarks          Float     @default(100)
  date              DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([schoolId])
  @@index([classId])
  @@index([subjectId])
  @@map("assessments")
}

model ReportCard {
  id                  String    @id @default(uuid())
  schoolId            String
  school              School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId           String
  student             Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId             String?
  academicYear        String    // e.g. "2025/2026"
  term                String    // e.g. "Term 1"
  
  totalScore          Float     @default(0)
  averageScore        Float     @default(0)
  rank                Int?
  aggregateScore      Int?      // Ghana BECE stanine aggregate (6 to 54)
  aggregateRemark     String?   // "Distinction", "Merit", etc.
  
  attendancePresent   Int       @default(0)
  attendanceTotal     Int       @default(0)
  conduct             String?   @default("Good")
  attitude            String?   @default("Hardworking")
  interest            String?   @default("Sports & Reading")
  
  classTeacherRemarks String?
  headteacherRemarks  String?
  promotedTo          String?
  
  status              String    @default("DRAFT") // DRAFT, APPROVED, PUBLISHED
  publishedAt         DateTime?
  
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([schoolId, studentId, academicYear, term])
  @@index([schoolId])
  @@index([studentId])
  @@map("report_cards")
}

// ============================================
// PHASE 6 UPGRADES: FEES, BILLING & REVERSALS
// ============================================

model FeeCategory {
  id          String        @id @default(uuid())
  schoolId    String
  school      School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String        // Tuition, Feeding, Books, ICT, PTA, Examination, Transport, Boarding, Uniform
  code        String
  description String?
  isOptional  Boolean       @default(false)
  isActive    Boolean       @default(true)
  frequency   String        @default("TERMLY") // TERMLY, ONE_TIME, ANNUAL, MONTHLY
  bills       StudentBill[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([schoolId, code])
  @@index([schoolId])
  @@map("fee_categories")
}

model StudentBill {
  id             String       @id @default(uuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeCategoryId  String?
  feeCategory    FeeCategory? @relation(fields: [feeCategoryId], references: [id], onDelete: SetNull)
  billNumber     String       // School unique bill #
  academicYear   String
  term           String
  totalAmount    Float
  discountAmount Float        @default(0)
  paidAmount     Float        @default(0)
  balance        Float
  status         String       @default("PENDING") // PENDING, PARTIAL, PAID, OVERDUE
  dueDate        DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([schoolId, billNumber])
  @@index([schoolId])
  @@index([studentId])
  @@index([feeCategoryId])
  @@map("student_bills")
}

model PaymentAllocation {
  id          String   @id @default(uuid())
  paymentId   String
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  feeCategory String   // ARREARS, TUITION, FEEDING, TRANSPORT, OTHER
  amount      Float
  createdAt   DateTime @default(now())

  @@index([paymentId])
  @@map("payment_allocations")
}

model PaymentReversal {
  id              String   @id @default(uuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  paymentId       String   @unique
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  reversedBy      String   // User ID or name
  reason          String
  reversalReceipt String   @unique // e.g. REV-REC-00123
  createdAt       DateTime @default(now())

  @@index([schoolId])
  @@map("payment_reversals")
}

// ============================================
// ACCOUNTING: CHART OF ACCOUNTS, INCOME, BANK
// ============================================

model AccountHead {
  id          String   @id @default(uuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String   // Tuition Income, Feeding Income, Salary Expense, Utilities, Stationery
  code        String
  type        String   // INCOME, EXPENSE, ASSET, LIABILITY
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([schoolId, code])
  @@index([schoolId])
  @@map("account_heads")
}

model IncomeTransaction {
  id            String   @id @default(uuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  accountHead   String   // Category code or name
  amount        Float
  currency      String   @default("GHS")
  incomeDate    DateTime @default(now())
  payer         String?
  reference     String?
  paymentMethod String   // CASH, BANK, MOBILE_MONEY
  receiptNumber String?
  description   String?
  receivedBy    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([schoolId])
  @@index([incomeDate])
  @@map("income_transactions")
}

model BankAccount {
  id             String   @id @default(uuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  accountName    String
  bankName       String   // e.g. GCB, Ecobank, Stanbic, CalBank, MTN MoMo Merchant
  accountNumber  String
  branch         String?
  openingBalance Float    @default(0)
  currentBalance Float    @default(0)
  currency       String   @default("GHS")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([schoolId, accountNumber])
  @@index([schoolId])
  @@map("bank_accounts")
}

// ============================================
// PHASE 8 UPGRADES: EXEATS, BOARDING & VISITORS
// ============================================

model ExeatRequest {
  id              String    @id @default(uuid())
  schoolId        String
  school          School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId       String
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reason          String
  destination     String
  departureTime   DateTime
  expectedReturn  DateTime
  actualReturn    DateTime?
  approvedBy      String?
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED, RETURNED, OVERDUE
  parentContacted Boolean   @default(false)
  remarks         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([schoolId])
  @@index([studentId])
  @@index([status])
  @@map("exeat_requests")
}

model Dormitory {
  id          String         @id @default(uuid())
  schoolId    String
  school      School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String         // e.g. "Hall of Excellence Block A"
  gender      String         // MALE, FEMALE
  houseMaster String?
  capacity    Int            @default(50)
  beds        DormitoryBed[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("dormitories")
}

model DormitoryBed {
  id          String          @id @default(uuid())
  dormitoryId String
  dormitory   Dormitory       @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)
  bedNumber   String          // e.g. "BED-01-A"
  isOccupied  Boolean         @default(false)
  allocations BedAllocation[]

  @@unique([dormitoryId, bedNumber])
  @@index([dormitoryId])
  @@map("dormitory_beds")
}

model BedAllocation {
  id            String       @id @default(uuid())
  bedId         String
  bed           DormitoryBed @relation(fields: [bedId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  allocatedDate DateTime     @default(now())
  releasedDate  DateTime?
  status        String       @default("ACTIVE") // ACTIVE, VACATED

  @@index([bedId])
  @@index([studentId])
  @@map("bed_allocations")
}

model VisitorLog {
  id          String    @id @default(uuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  visitorName String
  phoneNumber String
  hostPerson  String    // Staff or student being visited
  purpose     String    // ENQUIRY, PARENT_VISIT, DELIVERY, OFFICIAL
  timeIn      DateTime  @default(now())
  timeOut     DateTime?
  badgeNumber String?
  remarks     String?
  recordedBy  String?
  createdAt   DateTime  @default(now())

  @@index([schoolId])
  @@index([timeIn])
  @@map("visitor_logs")
}

// ============================================
// PHASE 5 UPGRADES: LESSON PLANS
// ============================================

model LessonPlan {
  id             String   @id @default(uuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherId      String
  teacher        Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classId        String
  subjectId      String
  weekNumber     Int
  lessonDate     DateTime
  topic          String
  objectives     String
  contentSummary String
  activities     String
  resources      String?  // Teaching and Learning Materials (TLMs)
  assessment     String?
  evaluation     String?  // Teacher's reflection
  status         String   @default("SUBMITTED") // DRAFT, SUBMITTED, APPROVED, REVISE
  approvedBy     String?
  reviewComments String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([schoolId])
  @@index([teacherId])
  @@index([classId])
  @@map("lesson_plans")
}

// ============================================
// PHASE 7 UPGRADES: HR & GHANA PAYROLL ENGINE
// ============================================

model SalaryStructure {
  id                 String   @id @default(uuid())
  schoolId           String
  school             School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staffId            String   @unique
  staff              Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  basicSalary        Float
  housingAllowance   Float    @default(0)
  transportAllowance Float    @default(0)
  otherAllowances    Float    @default(0)
  ssnitNumber        String?
  tinNumber          String?  // Ghana Taxpayer Identification Number
  bankName           String?
  accountNumber      String?
  effectiveDate      DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([schoolId])
  @@map("salary_structures")
}

model PayrollPeriod {
  id          String       @id @default(uuid())
  schoolId    String
  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  month       Int          // 1 to 12
  year        Int          // e.g. 2026
  status      String       @default("DRAFT") // DRAFT, REVIEW, APPROVED, FINALIZED, LOCKED
  totalGross  Float        @default(0)
  totalPaye   Float        @default(0)
  totalSsnit  Float        @default(0)
  totalNet    Float        @default(0)
  approvedBy  String?
  finalizedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  runs        PayrollRun[]
  payslips    Payslip[]

  @@unique([schoolId, month, year])
  @@index([schoolId])
  @@map("payroll_periods")
}

model PayrollRun {
  id              String        @id @default(uuid())
  payrollPeriodId String
  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  schoolId        String
  school          School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  processedBy     String?
  totalStaff      Int           @default(0)
  totalGross      Float         @default(0)
  totalNet        Float         @default(0)
  createdAt       DateTime      @default(now())

  items           PayrollItem[]

  @@index([payrollPeriodId])
  @@index([schoolId])
  @@map("payroll_runs")
}

model PayrollItem {
  id              String     @id @default(uuid())
  payrollRunId    String
  payrollRun      PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  staffId         String
  staff           Staff      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  
  basicSalary     Float
  allowances      Float      @default(0)
  bonus           Float      @default(0)
  grossSalary     Float
  
  // Ghana Statutory Deductions
  taxableIncome   Float
  paye            Float      // Ghana GRA PAYE
  ssnitTier1      Float      @default(0) // 13.5% employer
  ssnitTier2      Float      // 5.5% employee contribution
  loansAdvance    Float      @default(0)
  otherDeductions Float      @default(0)
  totalDeductions Float
  
  netSalary       Float
  paymentStatus   String     @default("PENDING") // PENDING, PAID

  createdAt       DateTime   @default(now())

  @@index([payrollRunId])
  @@index([staffId])
  @@map("payroll_items")
}

model Payslip {
  id               String        @id @default(uuid())
  schoolId         String
  school           School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  payrollPeriodId  String
  payrollPeriod    PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  staffId          String
  staff            Staff         @relation(fields: [staffId], references: [id], onDelete: Cascade)
  payslipNumber    String        @unique // e.g. SLIP-2026-09-001
  
  basicSalary      Float
  allowances       Float
  grossSalary      Float
  paye             Float
  ssnit            Float
  otherDeductions  Float
  totalDeductions  Float
  netSalary        Float
  
  paymentMethod    String        @default("BANK")
  paymentReference String?
  generatedAt      DateTime      @default(now())

  @@unique([payrollPeriodId, staffId])
  @@index([schoolId])
  @@index([staffId])
  @@map("payslips")
}

// ============================================
// PHASE 9 UPGRADES: SMS, MESSAGES & ID CARDS
// ============================================

model SmsLog {
  id             String   @id @default(uuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  recipientPhone String
  message        String
  senderId       String   // e.g. "TLS001" or School Name
  creditsUsed    Float    @default(1)
  status         String   @default("SENT") // SENT, DELIVERED, FAILED
  providerRef    String?
  createdAt      DateTime @default(now())

  @@index([schoolId])
  @@index([status])
  @@map("sms_logs")
}

model SmsTemplate {
  id          String   @id @default(uuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title       String   // Fee Reminder, Absence Alert, Result Notice
  templateKey String   // FEE_REMINDER, ABSENT_ALERT, RESULT_READY, GENERAL
  content     String   // "Dear Parent, your ward {student_name} has outstanding fees of {amount}..."
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([schoolId, templateKey])
  @@index([schoolId])
  @@map("sms_templates")
}

model Message {
  id              String    @id @default(uuid())
  schoolId        String
  school          School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  senderUserId    String
  recipientUserId String
  subject         String?
  content         String
  isRead          Boolean   @default(false)
  readAt          DateTime?
  createdAt       DateTime  @default(now())

  @@index([schoolId])
  @@index([recipientUserId])
  @@index([senderUserId])
  @@map("messages")
}

model IdCardTemplate {
  id                 String   @id @default(uuid())
  schoolId           String
  school             School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  templateType       String   // STUDENT, STAFF
  layout             String   @default("STANDARD") // STANDARD, MODERN, COMPACT
  primaryColor       String   @default("#1e3a8a")
  showQrCode         Boolean  @default(true)
  showBloodGroup     Boolean  @default(false)
  showEmergencyPhone Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([schoolId, templateType])
  @@index([schoolId])
  @@map("id_card_templates")
}


